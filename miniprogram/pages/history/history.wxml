<view class="page">
  <view class="bg-layer" style="{{bgStyle}}"></view>

  <block wx:if="{{!space}}">
    <view class="empty"><view class="empty-text">加载中…</view></view>
  </block>

  <block wx:elif="{{space.type !== 'family'}}">
    <view class="page-head">
      <view class="ph-title">历史订单</view>
    </view>
    <view class="card mt-24">这是家庭空间的功能。</view>
  </block>

  <block wx:else>
    <view class="page-head">
      <view class="ph-title">历史订单</view>
      <view class="ph-sub">{{list.length}} 道已上桌 · 做完的菜自动存这儿</view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">
      <image class="empty-img" src="/images/ic/order.png" />
      <view class="empty-text">还没有做完的菜</view>
    </view>

    <view wx:else class="list">
      <view wx:for="{{list}}" wx:key="_id" class="row">
        <image wx:if="{{item.image}}" class="row-thumb" src="{{item.image}}" mode="aspectFill" />
        <view class="flex-1">
          <view class="row-title">{{item.name}}<text wx:if="{{item.qty > 1}}" class="order-qty">×{{item.qty}}</text></view>
          <view class="row-desc">{{item.byName || '家人'}} 点 · {{item.takerName || '家人'}} 做</view>
        </view>
        <view class="t-3 fz24">{{item.doneText}}</view>
      </view>
    </view>
  </block>

</view>
