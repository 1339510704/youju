<view class="page page-bar">
  <member-banner wx:if="{{memberExpired}}" />
  <view class="bg-layer" style="{{bgStyle}}"></view>

  <block wx:if="{{!space}}">
    <view class="empty"><view class="empty-text">加载中…</view></view>
  </block>

  <block wx:else>
    <view class="page-head">
      <view class="ph-title">重要节日</view>
      <view class="ph-sub">{{list.length}} 个节日</view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">
      <image class="empty-img" src="/images/ic/festival.png" />
      <view class="empty-text">还没有记录节日，点右下角加一个</view>
    </view>

    <view wx:else class="list mt-20">
      <!-- 左滑露出「删除」 -->
      <view wx:for="{{list}}" wx:key="_id" class="swipe">
        <view class="swipe-body" style="transform:translateX({{_swipeId === item._id ? '-172rpx' : '0'}});"
              bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd"
              data-id="{{item._id}}" bindtap="onItemTap">
          <view class="row">
            <view class="ico"><image class="ico-img" src="/images/ic/festival.png" /></view>
            <view class="flex-1 ml-16">
              <view class="bold">{{item.name}}</view>
              <!-- 日期 · 农历 · 内容 · 天数（按用户选择）：同一行、不同颜色 -->
              <view class="fest-line">
                <text class="fz24 fest-meta">
                  <text class="t-2">{{item.date}}{{item.lunarText ? ' · 农历' + item.lunarText : ''}}</text>
                  <text wx:if="{{item.note}}" class="fest-note"> · {{item.note}}</text>
                </text>
                <text wx:for="{{item.dayChips}}" wx:for-item="c" wx:key="text" class="{{c.cls}}">{{c.text}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="swipe-act" catchtap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>
  </block>
<!-- 底部固定主操作（大按钮，好找、点击区大） -->
  <view class="actionbar">
    <view class="btn btn-primary btn-lg btn-fill" bindtap="openAdd">＋ 记录节日</view>
  </view>

  <!-- 新增弹层 -->
  <view wx:if="{{showAdd}}" class="mask" bindtap="closeAdd">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{_editId ? '编辑节日' : '新增节日'}}</view>
        <view class="sheet-close" bindtap="closeAdd">✕</view>
      </view>
      <input class="sheet-input" placeholder="名称，如：爱人的生日" value="{{name}}" bindinput="onName" />

      <!-- 公历 / 农历 切换 + 日期：同一行 -->
      <view class="fest-row">
        <view class="fest-type">
          <view class="fest-type-i {{isLunar ? '' : 'on'}}" bindtap="switchType" data-t="solar">公历</view>
          <view class="fest-type-i {{isLunar ? 'on' : ''}}" bindtap="switchType" data-t="lunar">农历</view>
        </view>
        <picker class="fest-date" mode="date" value="{{date}}" bindchange="onDate">
          <view class="tag">{{date || '选择日期'}}</view>
        </picker>
      </view>
      <view wx:if="{{isLunar}}" class="fest-hint">农历 {{lText || '—'}}</view>

      <!-- 天数显示方式：倒计时 / 累计 -->
      <view class="field">
        <text class="field-label">天数显示</text>
        <picker mode="selector" range="{{dayOptions}}" value="{{dayModeIdx}}" bindchange="onMode">
          <view class="tag">{{dayModeText}}</view>
        </picker>
      </view>

      <input class="sheet-input mt-16" placeholder="备注（可选）" value="{{note}}" bindinput="onNote" />

      <view class="field">
        <text class="field-label">提前提醒</text>
        <picker mode="selector" range="{{leadOptions}}" value="{{leadIdx}}" bindchange="onLead">
          <view class="tag">{{leadOptions[leadIdx]}}</view>
        </picker>
      </view>

      <!-- 提醒谁：以前节日提醒是无条件发给全家的，这里补上选择 -->
      <view class="field">
        <text class="field-label">提醒谁</text>
        <picker mode="selector" range="{{toOptions}}" value="{{toIdx}}" bindchange="onTo">
          <view class="tag">{{toOptions[toIdx]}}</view>
        </picker>
      </view>
      <view class="btn btn-primary btn-block" style="margin-top:56rpx" bindtap="save">保存</view>
    </view>
  </view>

</view>
