/* 个人资料页私有样式（公共样式在 app.wxss） */

/* 头像：视觉层（image / 渐变底）与点击热区（透明 button）分离。
   微信 button 自带 ::after 描边，圆角裁剪后会在边角露出三角残影，
   所以不再让 button 承担视觉，只留一个全区域透明的点击层。 */
.avatar-wrap { position: relative; width: 160rpx; height: 160rpx; flex-shrink: 0; }
.avatar-pic  { width: 160rpx; height: 160rpx; border-radius: 50%; display: block; background: var(--fill); }
.avatar-ph   { width: 160rpx; height: 160rpx; border-radius: 50%; background: linear-gradient(135deg,#ffc0a8,#ff6b3d); color: #fff; font-size: 56rpx; display: flex; align-items: center; justify-content: center; }
.avatar-cam  {
  position: absolute; right: 0; bottom: 0;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #fff; border: 2rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(34,28,24,.10);
}
.avatar-cam image { width: 30rpx; height: 30rpx; opacity: .7; }
.avatar-hit  {
  position: absolute; left: 0; top: 0; width: 160rpx; height: 160rpx;
  padding: 0; margin: 0; background: transparent; border: none;
  border-radius: 50%; opacity: 0;
}
.avatar-hit::after { border: none; }

/* 背景色块：三列 + 名字，避免淡色看不出来 */
.bg-cell { display: flex; flex-direction: column; align-items: center; }
.bg-swatch {
  width: 100%; height: 104rpx; border-radius: 18rpx;
  border: 2rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.bg-swatch.on { border-color: var(--brand-btn); border-width: 4rpx; }
.bg-check { color: var(--brand-btn); font-size: 34rpx; line-height: 1; font-weight: 700; }
.bg-name { font-size: 24rpx; color: var(--text-2); margin-top: 10rpx; }

.bg-preview {
  width: 100%; height: 260rpx; border-radius: 20rpx;
  display: block; margin-bottom: 12rpx;
}

/* 昵称：放在头像右侧，点一下就能改（不额外写操作提示） */
.nick-input {
  width: 100%; height: 96rpx; padding: 0 24rpx;
  background: var(--fill); border-radius: var(--radius);
  font-size: 34rpx; font-weight: 600; color: var(--text);
  border: 2rpx solid transparent;
}
.nick-input:focus { background: #fff; border-color: var(--brand-line); }

/* 背景透明度：作用于所有页面的背景层 */
.alpha-row {
  margin-top: 28rpx; padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}
.alpha-row slider { margin: 8rpx 0 4rpx; }
