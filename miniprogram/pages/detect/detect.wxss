/* ============================================================
   侦探社
   ============================================================ */
.detect-page { padding-bottom: 60rpx; }

.page-head { padding: 24rpx 32rpx 0; }
.d-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--text-3); }

/* ---------- 顶部切换 ---------- */
.d-tabs {
  display: flex; gap: 12rpx;
  margin: 24rpx 32rpx 8rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, .8);
  border-radius: 999rpx;
}
.d-tab {
  flex: 1; text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx; font-weight: 600;
  color: var(--text-3);
  border-radius: 999rpx;
}
.d-tab.on { background: var(--accent, #E8501F); color: #fff; }

/* ---------- 提问 ---------- */
.card { margin: 16rpx 32rpx; }
.d-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
}
.d-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.d-hint { flex: 1; font-size: 22rpx; color: var(--text-3); }
.d-err { color: #c0392b; font-size: 26rpx; }

.d-answer-card { padding-top: 28rpx; }
.d-point { display: flex; align-items: flex-start; gap: 10rpx; }
.d-point + .d-point { margin-top: 20rpx; }
.d-point-dot { flex: none; font-size: 34rpx; line-height: 1.3; color: var(--accent, #E8501F); }
.d-point-body { flex: 1; min-width: 0; }
.d-point-text { font-size: 30rpx; line-height: 1.7; color: var(--text); }
.d-point-src { margin-top: 8rpx; font-size: 22rpx; color: var(--text-3); }
.d-from { margin-top: 20rpx; font-size: 22rpx; color: var(--text-3); text-align: right; }

.d-src-title { font-size: 28rpx; line-height: 1.5; color: var(--text); }
.d-src-meta { margin-top: 6rpx; }
.d-tag { margin-right: 8rpx; }
.d-note { margin: 12rpx 32rpx 0; font-size: 22rpx; color: var(--text-3); }

/* ---------- 出题表单 ---------- */
.d-create-title { font-size: 32rpx; font-weight: 700; }
.d-create-sub { margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; color: var(--text-3); }
.d-label { margin: 28rpx 0 12rpx; font-size: 24rpx; color: var(--text-3); }

.d-cats { display: flex; flex-wrap: wrap; gap: 14rpx; }
.d-cat {
  padding: 12rpx 26rpx;
  font-size: 26rpx; color: var(--text-2);
  background: rgba(0, 0, 0, .04);
  border-radius: 999rpx;
}
.d-cat.on { background: var(--accent, #E8501F); color: #fff; font-weight: 600; }

.d-topic-input {
  height: 84rpx; padding: 0 20rpx;
  font-size: 28rpx;
  background: rgba(0, 0, 0, .04);
  border-radius: 16rpx;
}

.d-modes { display: flex; gap: 16rpx; }
.d-mode {
  flex: 1;
  padding: 20rpx;
  background: rgba(0, 0, 0, .035);
  border: 2rpx solid transparent;
  border-radius: 18rpx;
}
.d-mode.on { border-color: var(--accent, #E8501F); background: rgba(232, 80, 31, .07); }
.d-mode-t { font-size: 28rpx; font-weight: 600; }
.d-mode-s { margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-3); }

.d-rounds { display: flex; align-items: center; gap: 12rpx; margin-top: 28rpx; }
.d-rounds-label { font-size: 24rpx; color: var(--text-3); margin-right: 4rpx; }
.d-rounds-item {
  min-width: 72rpx; text-align: center;
  padding: 10rpx 0;
  font-size: 26rpx; color: var(--text-2);
  background: rgba(0, 0, 0, .04);
  border-radius: 12rpx;
}
.d-rounds-item.on { background: var(--accent, #E8501F); color: #fff; font-weight: 600; }

.d-join-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.d-code-input {
  flex: 1; height: 84rpx; padding: 0 20rpx;
  font-size: 32rpx; letter-spacing: 6rpx;
  background: rgba(0, 0, 0, .04);
  border-radius: 16rpx;
}

/* ---------- 等对方 ---------- */
.d-wait { padding: 48rpx 32rpx; }
.d-wait-label { font-size: 24rpx; color: var(--text-3); }
.d-wait-code {
  margin-top: 10rpx;
  font-size: 84rpx; font-weight: 800; letter-spacing: 12rpx;
  color: var(--accent, #E8501F);
}
.d-wait-tip { margin-top: 10rpx; font-size: 26rpx; line-height: 1.7; color: var(--text-2); }
.d-wait-players { margin-top: 20rpx; font-size: 24rpx; color: var(--text-3); }

/* ---------- 比分条 ---------- */
.d-score { display: flex; align-items: center; gap: 16rpx; }
.d-player {
  flex: 1; padding: 16rpx; text-align: center;
  background: rgba(0, 0, 0, .03);
  border-radius: 16rpx;
}
.d-player.me { background: rgba(232, 80, 31, .09); }
.d-p-name { font-size: 24rpx; color: var(--text-2); }
.d-p-score { margin: 4rpx 0; font-size: 44rpx; font-weight: 800; color: var(--text); }
.d-p-state { font-size: 22rpx; color: var(--text-3); }
.d-progress { font-size: 22rpx; color: var(--text-3); writing-mode: vertical-rl; letter-spacing: 2rpx; }

.d-solo-bar {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 26rpx; color: var(--text-2);
}
.d-solo-score { font-weight: 700; color: var(--accent, #E8501F); }

/* ---------- 题目 ---------- */
.d-q { padding-top: 32rpx; }
.d-q-label { font-size: 22rpx; color: var(--text-3); letter-spacing: 1rpx; }
.d-claim {
  margin-top: 14rpx;
  font-size: 34rpx; font-weight: 600; line-height: 1.65;
  color: var(--text);
}

.d-choices { display: flex; gap: 20rpx; margin-top: 32rpx; }
.d-choice {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 28rpx 0;
  border: 3rpx solid transparent;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, .035);
}
.d-choice-ic { font-size: 44rpx; line-height: 1; color: var(--text-3); }
.d-choice-t { font-size: 30rpx; font-weight: 700; color: var(--text); }
.d-choice.real.on { border-color: #2f9e44; background: rgba(47, 158, 68, .1); }
.d-choice.real.on .d-choice-ic, .d-choice.real.on .d-choice-t { color: #2f9e44; }
.d-choice.fake.on { border-color: #d93b30; background: rgba(217, 59, 48, .08); }
.d-choice.fake.on .d-choice-ic, .d-choice.fake.on .d-choice-t { color: #d93b30; }
/* 揭晓后：正确答案描边，选错的那个再压一层红 */
.d-choice.right { border-color: #2f9e44; background: rgba(47, 158, 68, .1); }
.d-choice.right .d-choice-ic, .d-choice.right .d-choice-t { color: #2f9e44; }
.d-choice.wrong { border-color: #d93b30; background: rgba(217, 59, 48, .08); }
.d-choice.wrong .d-choice-ic, .d-choice.wrong .d-choice-t { color: #d93b30; }

.d-q-tip { margin-top: 20rpx; font-size: 22rpx; color: var(--text-3); text-align: center; }

.d-verdict {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(47, 158, 68, .1);
}
.d-verdict.bad { background: rgba(217, 59, 48, .08); }
.d-verdict-main { display: block; font-size: 34rpx; font-weight: 800; color: #2f9e44; }
.d-verdict.bad .d-verdict-main { color: #d93b30; }
.d-verdict-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }

.d-origin {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 25rpx; line-height: 1.7;
  color: var(--text-2);
  background: rgba(0, 0, 0, .035);
  border-radius: 16rpx;
}
.d-origin-label { color: var(--text-3); }

/* ---------- 结果 ---------- */
.d-result { padding: 40rpx 32rpx; }
.d-result-title { font-size: 36rpx; font-weight: 800; }
.d-result-sub { margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; color: var(--text-2); }

.d-actions { margin: 28rpx 32rpx 0; }
