/* 背景图设置（二级页）私有样式 */
.bg-place { padding: 24rpx 28rpx; }
.bg-place + .bg-place { border-top: 2rpx solid var(--line); }
.alpha-row { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx dashed var(--line-2); }
.alpha-row slider { margin: 6rpx 0 4rpx; }
.alpha-off { opacity: .5; }

.bg-preview {
  width: 100%; height: 240rpx; border-radius: 20rpx;
  display: block; margin-bottom: 4rpx;
}

/* 纯色背景：可选色圆点 */
.color-row { display: flex; flex-wrap: wrap; gap: 20rpx; }
.color-dot {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 2rpx solid var(--line);
  box-shadow: inset 0 0 0 4rpx #fff;
}
.color-dot.on {
  border-color: var(--brand-btn);
  box-shadow: inset 0 0 0 4rpx #fff, 0 0 0 4rpx rgba(232, 80, 31, .25);
}
