<view class="page">
  <view class="bg-layer" style="{{bgStyle}}"></view>

  <view class="page-head">
    <view class="ph-title">背景图设置</view>
    <view class="ph-sub">选一张图铺满全部位置，也能逐个界面单独开关、单独调透明度</view>
  </view>

  <!-- 背景图来源 -->
  <view class="sec">背景图来源</view>
  <view class="card">
    <view class="flex-between">
      <view class="flex-1">
        <view class="row-title">{{srcText}}</view>
        <view class="row-desc">家庭背景图全家人可见；没有图时用下面的纯色</view>
      </view>
      <view class="btn btn-ghost btn-sm" bindtap="chooseSpaceBg">换图</view>
    </view>
    <view wx:if="{{spaceBg.url && spaceBg.valid}}" class="mt-16">
      <image src="{{spaceBg.url}}" class="bg-preview" mode="aspectFill" />
      <view class="flex gap-12 mt-12">
        <view class="btn btn-primary btn-sm" bindtap="applyAll">应用到全部位置</view>
        <view class="btn btn-ghost btn-sm" bindtap="clearSpaceBg">恢复默认背景</view>
      </view>
    </view>
    <view wx:if="{{spaceBg.mode === 'member' || spaceBg.mode === 'expired'}}" class="row-desc t-primary mt-12">
      {{spaceBg.mode === 'member' ? '会员有效期内一直可用' : '会员已到期，续费后自动恢复'}}
    </view>

    <!-- 背景不显示时的一键自检：一条一条告诉你是哪环断了 -->
    <view class="row-desc t-primary mt-16" bindtap="bgDiag">背景不显示？点此自检 ›</view>
  </view>

  <!-- 系统背景色：没有家庭背景图时，整页就用这个颜色 -->
  <view class="sec">系统背景色（无背景图时生效）</view>
  <view class="card">
    <view class="row-desc">家里没设背景图时，用这个纯色做整页底色。点一下即保存。</view>
    <view class="color-row mt-16">
      <view wx:for="{{presets}}" wx:key="key"
            class="color-dot {{item.value === bgColor ? 'on' : ''}}"
            style="background:{{item.value}}"
            bindtap="pickColor" data-v="{{item.value}}"></view>
    </view>
    <view wx:if="{{bgColor}}" class="t-3 fz22 mt-12" bindtap="pickColor" data-v="">恢复默认白色</view>
  </view>

  <!-- 一键设置全部位置 -->
  <view class="sec">一键设置全部位置</view>
  <view class="card">
    <view class="row-desc">不想逐个调，就先用一张图铺满所有界面，再用下面的滑杆统一调浓淡，之后也能单独微调。</view>
    <view class="alpha-row" style="margin-top:14rpx;padding-top:14rpx;border-top:2rpx dashed var(--line-2)">
      <view class="flex-between">
        <text class="row-title">统一透明度（全部位置）</text>
        <text class="t-primary fz24">{{masterPct}}%</text>
      </view>
      <slider min="0" max="100" value="{{masterPct}}" activeColor="#E8501F" block-size="20"
              bindchanging="onMasterAlphaPreview" bindchange="onMasterAlphaSave" />
      <view class="t-3 fz22">拖动一下，四个界面的背景一起变淡 / 变浓</view>
    </view>
  </view>

  <!-- 各位置：开关 + 透明度 -->
  <view class="sec">每个界面单独设置</view>
  <view class="list">
    <view wx:for="{{places}}" wx:key="key" class="bg-place">
      <view class="flex-between">
        <view class="bold fz28">{{item.name}}</view>
        <switch checked="{{item.on}}" bindchange="onToggle" data-k="{{item.key}}" color="#E8501F" />
      </view>
      <view class="alpha-row {{item.on ? '' : 'alpha-off'}}">
        <view class="flex-between">
          <text class="row-title">背景透明度</text>
          <text class="t-primary fz24">{{item.alphaPct}}%</text>
        </view>
        <slider min="0" max="100" value="{{item.alphaPct}}" disabled="{{!item.on}}"
                activeColor="#E8501F" block-size="20"
                bindchanging="onAlphaPreview" bindchange="onAlphaSave" data-k="{{item.key}}" />
        <view class="t-3 fz22">数值越小背景越淡，不影响文字阅读</view>
      </view>
    </view>
  </view>

  <view class="t-3 fz22 mt-16 ml-8">关掉某个界面后，那里会回落到默认背景，其它界面不受影响。</view>
</view>
