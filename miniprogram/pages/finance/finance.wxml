<view class="page page-bar">
  <member-banner wx:if="{{memberExpired}}" />
  <view class="bg-layer" style="{{bgStyle}}"></view>

  <block wx:if="{{!space}}">
    <view class="empty"><view class="empty-text">加载中…</view></view>
  </block>

  <block wx:else>
    <view class="page-head">
      <view class="ph-title">记账 理财</view>
      <view class="ph-sub">{{space.name}}</view>
    </view>

    <!-- 本月概览 -->
    <view class="card mt-20 fin-overview">
      <view class="fin-ov-cell">
        <view class="fin-ov-label">本月支出</view>
        <view class="fin-ov-num t-danger">¥{{hideAmount ? '****' : monthExpense}}</view>
      </view>
      <view class="fin-ov-sep"></view>
      <view class="fin-ov-cell">
        <view class="fin-ov-label">本月收入</view>
        <view class="fin-ov-num t-success">¥{{hideAmount ? '****' : monthIncome}}</view>
      </view>
      <view class="fin-ov-sep"></view>
      <view class="fin-ov-cell fin-ov-balance">
        <view class="fin-ov-label">累计结余</view>
        <view class="fin-ov-num {{balance >= 0 ? '' : 't-danger'}}">¥{{hideAmount ? '****' : balance}}</view>
        <text class="eye" bindtap="toggleHide">{{hideAmount ? '🙈' : '👁'}}</text>
      </view>
    </view>

    <!-- 理财目标 -->
    <view class="sec">理财目标</view>
    <view wx:if="{{plans.length}}" class="list">
      <view wx:for="{{plans}}" wx:key="_id" class="swipe">
        <view class="swipe-body" style="transform:translateX({{_swipeId === item._id ? '-172rpx' : '0'}});"
              bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd"
              data-id="{{item._id}}" bindtap="onPlanTap">
          <view class="plan-row">
            <view class="flex-c gap-12">
              <view class="bold">{{item.title}}</view>
              <view class="plan-pct">{{item.percent}}%</view>
            </view>
            <view class="flex-between mt-12">
              <text class="t-2 fz24">¥{{item.currentAmount}} / ¥{{item.targetAmount}}</text>
              <text wx:if="{{item.deadline}}" class="t-2 fz24">{{item.deadline}}</text>
            </view>
            <view class="bar mt-12"><view class="bar-fill" style="width:{{item.percent}}%"></view></view>
          </view>
        </view>
        <view class="swipe-act" catchtap="removePlan" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view wx:if="{{!plans.length}}" class="card center mt-12" style="padding:28rpx">
      <view class="t-2 fz24">还没有理财目标，攒钱更有动力</view>
    </view>
    <view class="mt-12">
      <view class="btn btn-ghost btn-block" bindtap="openPlan">＋ 新增理财目标</view>
    </view>

    <!-- 收支明细 -->
    <view class="sec">收支明细</view>
    <view wx:if="{{groups.length === 0}}" class="empty">
      <image class="empty-img" src="/images/ic/finance.png" />
      <view class="empty-text">还没有记账，点下面记一笔</view>
    </view>

    <block wx:else>
      <view wx:for="{{groups}}" wx:key="month" class="fin-group">
        <view class="fin-group-head">
          <text class="fin-group-month">{{item.label}}</text>
          <text class="fin-group-sum">收 ¥{{item.income}} · 支 ¥{{item.expense}}</text>
        </view>
        <view class="list">
          <view wx:for="{{item.items}}" wx:key="_id" wx:for-item="f" class="swipe">
            <view class="swipe-body" style="transform:translateX({{_swipeId === f._id ? '-172rpx' : '0'}});"
                  bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd"
                  data-id="{{f._id}}" bindtap="onItemTap">
              <view class="row fin-row">
                <view class="fin-dot" style="background:{{f.catDot}}"></view>
                <view class="flex-1 ml-16">
                  <view class="bold">{{f.category}}</view>
                  <view class="t-2 fz24 ellipsis">{{f.note || f.planTitle || f.creatorName || f.category}}</view>
                  <view wx:if="{{f.whenText}}" class="t-3 fz20 mt-4">{{f.whenText}}</view>
                </view>
                <view class="fin-amt {{f.type === 'income' ? 't-success' : 't-danger'}}">{{f.type === 'income' ? '+' : '-'}}¥{{hideAmount ? '****' : f.amount}}</view>
              </view>
            </view>
            <view class="swipe-act" catchtap="remove" data-id="{{f._id}}">删除</view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view class="actionbar">
    <view class="btn btn-primary btn-lg btn-fill" bindtap="openAdd">＋ 记一笔</view>
  </view>

  <!-- 记一笔 -->
  <view wx:if="{{showAdd}}" class="mask" bindtap="closeAdd">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{_editId ? '编辑这笔' : '记一笔'}}</view>
        <view class="sheet-close" bindtap="closeAdd">✕</view>
      </view>
      <view class="seg">
        <view class="seg-item {{type === 'expense' ? 'seg-item-on' : ''}}" bindtap="setType" data-t="expense">支出</view>
        <view class="seg-item {{type === 'income' ? 'seg-item-on' : ''}}" bindtap="setType" data-t="income">收入</view>
      </view>
      <view class="fin-amt-input">
        <text class="fin-amt-sym">¥</text>
        <input class="fin-amt-field" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" />
      </view>
      <view class="fin-cats">
        <view wx:for="{{categories}}" wx:key="*this" class="fin-cat {{catIndex === index ? 'on' : ''}}" bindtap="onCatTap" data-i="{{index}}">{{item}}</view>
      </view>
      <view wx:if="{{planOptions.length > 1}}" class="field">
        <text class="field-label">算进哪个理财目标</text>
        <picker range="{{planOptions}}" value="{{planIndex}}" bindchange="onPlanPick">
          <view class="tag">{{planOptions[planIndex]}}</view>
        </picker>
      </view>
      <input class="sheet-input mt-16" placeholder="备注（可选）" value="{{note}}" bindinput="onNote" />
      <view class="btn btn-primary btn-block mt-24" bindtap="save">保存</view>
    </view>
  </view>

  <!-- 新增理财目标 -->
  <view wx:if="{{showPlan}}" class="mask" bindtap="closePlan">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{_editPlanId ? '编辑目标' : '理财目标'}}</view>
        <view class="sheet-close" bindtap="closePlan">✕</view>
      </view>
      <input class="sheet-input" placeholder="目标名称，如：春节旅游基金" value="{{planTitle}}" bindinput="onPlanTitle" />
      <input class="sheet-input mt-16" type="digit" placeholder="目标金额" value="{{planTarget}}" bindinput="onPlanTarget" />
      <input class="sheet-input mt-16" type="digit" placeholder="已存金额（默认 0）" value="{{planCurrent}}" bindinput="onPlanCurrent" />
      <view class="field">
        <text class="field-label">目标日期</text>
        <picker mode="date" value="{{planDeadline}}" bindchange="onPlanDate">
          <view class="tag">{{planDeadline || '不设'}}</view>
        </picker>
      </view>
      <view class="btn btn-primary btn-block mt-24" bindtap="savePlan">保存</view>
    </view>
  </view>

</view>
