/* 自定义 tabBar：图标 56rpx、文字 26rpx（原生约 40rpx / 20rpx，明显偏小） */
.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 999;
  display: flex; align-items: stretch;
  height: 120rpx; box-sizing: content-box;   /* 显式定高：120 + 2rpx 边框 = 122，家页/点菜底栏按此对齐，消除缝隙 */
  background: #fff;
  border-top: 2rpx solid var(--line);
  box-shadow: var(--sh-up);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-item {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 14rpx 0 12rpx;
}
.tabbar-item:active { background: #faf8f5; }

.tabbar-ic { width: 56rpx; height: 56rpx; display: block; }
.tabbar-txt {
  font-size: 26rpx; line-height: 1.2; margin-top: 6rpx;
  color: var(--text-3);
}
.tabbar-item.on .tabbar-txt { color: var(--brand-btn); font-weight: 600; }
